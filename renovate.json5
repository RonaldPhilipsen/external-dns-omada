{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'abandonments:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    ':automergeBranch',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(Europe/Amsterdam)',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  packageRules: [
    {
      description: [
        'Auto-merge all updates from my own packages',
      ],
      matchPackageNames: [
        'ghcr.io/ronaldphilipsen/**',
        'ronaldphilipsen/**',
      ],
      automerge: true,
    },
  ],
}
